// FrostChain E-Skin Crate - Tang Nano 9K (GW1NR-LV9QN88PC6/I5) Pin Constraints
IO_LOC "clk_12m" 52;
IO_PORT "clk_12m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Ratiometric Sigma-Delta Comparator & Bridge Control Pins
IO_LOC "lvds_comp_in" 25;
IO_PORT "lvds_comp_in" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "dummy_ok_flag" 26;
IO_PORT "dummy_ok_flag" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "sd_1bit_fb" 27;
IO_PORT "sd_1bit_fb" IO_TYPE=LVCMOS33 DRIVE=8 SLEW_RATE=FAST;

IO_LOC "en_bridge_20ms" 28;
IO_PORT "en_bridge_20ms" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "chop_phase" 29;
IO_PORT "chop_phase" IO_TYPE=LVCMOS33 DRIVE=4;

// Status & Interrupt Outputs (Mapped to Onboard LEDs / ESP32-S3 IRQ Pins)
IO_LOC "tamper_alarm" 10;
IO_PORT "tamper_alarm" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC "sensor_fault" 11;
IO_PORT "sensor_fault" IO_TYPE=LVCMOS18 DRIVE=8;

// 16-Bit Drift-Compensated Strain Bus
IO_LOC "clean_strain_ue[0]" 30;
IO_PORT "clean_strain_ue[0]" IO_TYPE=LVCMOS33;
