	(text "Ratiometric: bridge, NTC and 1-bit feedback\nGPIOs share VCCIO -> supply drift cancels.\nNo precision reference IC is required.\nExcitation: 20 ms each 1 s (2% duty),\napproximately 5 uW average.\nTargets: >=13 ENOB @ 10 Hz; INT8 error <1%\nvs FP32; latency <=2 s; <=1 false alarm per\n1000 device-hours."
		(exclude_from_sim no)
		(at 175.768 198.628 0)
		(effects
			(font
				(size 0.95 0.95)
			)
			(justify left top)
		)
		(uuid "8a33a98e-db49-4d9e-99c8-0a113c9581de")
	)
